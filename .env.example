# ================================
# SYNTHESIA Configuration
# Copy this to .env and customize
# ================================

# Backend Configuration
PORT=8000
NUM_AGENTS=30
MAX_FPS=30
SIMULATION_WIDTH=1000
SIMULATION_HEIGHT=1000
LOG_LEVEL=INFO

# Frontend Configuration (build-time)
# Leave empty to auto-detect from page URL (recommended)
VITE_WS_URL=

# Docker Compose ports (optional overrides)
FRONTEND_PORT=3000
BACKEND_PORT=8000
